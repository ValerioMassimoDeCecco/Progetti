{
  "name": "LensDrop — trasferisci con uno sguardo",
  "short_name": "LensDrop",
  "description": "Trasferisci file, foto, video, audio e testo tra due dispositivi inquadrando un codice QR. Collegamento diretto, nessun upload.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
